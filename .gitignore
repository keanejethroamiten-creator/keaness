--[[
IMPROVED AIM — BIGGER FOV + STRONGER LOCK
✅ Locks tight to HEAD
✅ Much wider search range
✅ Smoother pull, no jitter
✅ FOV circle + ] toggle
✅ Silent / no prints
]]

-- SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- ⚙️ ADJUST THESE HOWEVER YOU WANT
local BaseFOV = 25               -- ✅ BIGGER FOV — picks up targets further out
local AimFOV = 20                -- ✅ Tighter when holding RMB
local AimStrength = 0.92         -- ✅ STRONGER LOCK — still lets you move mouse
local AimThroughWalls = true
local AimPart = "Head"

-- FOV CIRCLE
local ShowFOV = true
local FOVColor = Color3.fromRGB(255, 50, 50)
local FOVThickness = 1.5
local FOVTransparency = 0.7

local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = FOVThickness
FOVCircle.Color = FOVColor
FOVCircle.Transparency = FOVTransparency
FOVCircle.Filled = false
FOVCircle.Visible = ShowFOV

-- TOGGLE FOV — ] KEY
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightBracket then
        ShowFOV = not ShowFOV
    end
end)

-- HELPER
local function IsVisible(origin, targetPos)
    local ray = Ray.new(origin, (targetPos - origin).Unit * 2000)
    local ignore = {LocalPlayer.Character, Camera}
    local hit = workspace:FindPartOnRayWithIgnoreList(ray, ignore)
    return hit and hit:IsDescendantOf(targetPos.Parent)
end

-- GET TARGET — IMPROVED SELECTION
local function GetTarget(searchFOV)
    local best, bestAngle = nil, searchFOV
    local camPos, camDir = Camera.CFrame.Position, Camera.CFrame.LookVector

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local part = char:FindFirstChild(AimPart)
        if not hum or hum.Health <= 0 or not part then continue end

        local dir = (part.Position - camPos).Unit
        local angle = math.deg(math.acos(math.clamp(camDir:Dot(dir), -1, 1)))
        if angle > searchFOV then continue end
        if not AimThroughWalls and not IsVisible(camPos, part.Position) then continue end

        if angle < bestAngle then
            bestAngle, best = angle, part
        end
    end
    return best
end

-- MAIN — SMOOTHER + STRONGER AIM
RunService:BindToRenderStep("AimAssist", Enum.RenderPriority.Camera.Value + 1, function()
    -- Update FOV circle
    local vp = Camera.ViewportSize
    FOVCircle.Position = Vector2.new(vp.X/2, vp.Y/2)
    FOVCircle.Radius = (vp.X/2) * math.tan(math.rad(AimFOV))
    FOVCircle.Visible = ShowFOV

    -- AIM
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local target = GetTarget(AimFOV)
        if target then
            local camPos = Camera.CFrame.Position
            local targetDir = (target.Position - camPos).Unit
            -- ✅ Stronger pull, still smooth
            local finalDir = Camera.CFrame.LookVector:Lerp(targetDir, AimStrength)
            Camera.CFrame = CFrame.new(camPos, camPos + finalDir * 1000)
        end
    end
end)
